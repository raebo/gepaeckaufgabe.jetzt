.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
# VS Code
.vscode/
*.swp
*.swo
*~

# IntelliJ
.idea/
*.iml

# Sublime Text
*.sublime-*

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/
/bower_components/
/.pnpm-store/

# Hugo modules
/pkg/
