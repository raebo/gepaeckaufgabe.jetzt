#sectionPrices {
  background-color: $background-color-darker;
  padding-top: 10%;
  padding-bottom: 10%;
  display: flex;
  justify-content: center;   /* horizontal centering */
  align-items: flex-start;       /* vertical centering */
  min-height: 85vh;         /* full viewport height */
  padding: 2rem;             /* optional spacing on smaller screens */
  box-sizing: border-box;

  #pricesWrapper {
    max-width: 1200px;
    width: 100%;


    #priceHeadline {
      h1 {
        color: $color-important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 100;
        font-size: $headline-font-size;
        letter-spacing: 1px;
      }
    }
    #priceFlexWrapper {
      display: flex;
      flex-wrap: nowrap;
      gap: 2rem;
      flex-direction: row;
      width: 100%;
      align-items: flex-start;
      justify-content: center;


      .price-item {
        // Base styles for price items

        &--image {
          display: flex;
          justify-content: center:
          align-items: center;

          .img_wrapper {
            width: 90%;          /* or % */
            height: 450px;         /* defines how much of the image is visible */
            margin: 11% auto;        /* centers the wrapper in the page */
            border-radius: 16px;   /* rounded corners */
            overflow: hidden;      /* hide the rest of the image */
            display: flex;
            justify-content: center;
            align-items: center;


            img {
              width: 100%;
              height: 100%;
              object-fit: cover;     /* zoom/crop to fill wrapper */
              object-position: center 90%;
              display: block;
            }
          }
        }

        &--text {
          // Styles for text block

          .item {
            // Base styles for inner content rows and action row

            &--content-row {

              // Styles for content rows (h2, p, etc.)
              h2 {
                // Styles for the sub-headline
              }

              p {
                // Styles for paragraph
              }
            }

            &--action-row {

              // Styles for the action row
              a {
                // Styles for the action link/button
              }
            }
          }
        }
      }
    }
  }

}
